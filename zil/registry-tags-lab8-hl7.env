# Подключить на ВМ приложения перед docker compose pull / up:
#   set -a && . ./registry-tags-lab8-hl7.env && set +a
#
# Удалённая PostgreSQL (hl12): с хоста ВМ приложения порт **5433** (не 5432 внутри контейнера hl12).
# Логин/пароль должны совпадать с учёткой на hl12 (по методичке курса). Локальные значения rental/rental_pass —
# только если так завели БД; иначе переопределите SPRING_DATASOURCE_* ниже.
DBHOST=hl12.zil
DBPORT=5433
DBNAME=hl7
SCHEMANAME=hl7
# SPRING_DATASOURCE_USERNAME=rental
# SPRING_DATASOURCE_PASSWORD=...

# Образы: сначала Harbor (курс), при отсутствии своих тегов раскомментируйте fallback Docker Hub.
ZIL_APP_IMAGE=hl13.zil:8888/katya/zil-app:lab8
ZIL_ADDITIONAL_IMAGE=hl13.zil:8888/katya/zil-additional-service:lab8

# Fallback (готовые образы преподавателя, если Harbor недоступен):
# ZIL_APP_IMAGE=docker.io/rinakt/zil-app:hl7-latest
# ZIL_ADDITIONAL_IMAGE=docker.io/rinakt/zil-additional:hl7-latest
