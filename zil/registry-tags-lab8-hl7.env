# Передавать compose явно (иначе ошибки «DBNAME is missing» и т.п.):
#   docker compose --env-file registry-tags-lab8-hl7.env pull app additional
#   docker compose --env-file registry-tags-lab8-hl7.env up -d app additional
#
# Первый раз с Harbor: docker login hl13.zil:8888
# (при необходимости: insecure-registries в /etc/docker/daemon.json)
#
# Удалённая PostgreSQL (hl12): с hl07 порт 5433.
# SPRING_DATASOURCE_* — роль приложения (hl7), не суперпользователь postgres.
#
# ВАЖНО: DBNAME — это имя *базы* (как в psql -d), а SCHEMANAME — схема внутри неё.
# Если в базе «postgres» нет схемы hl7, а таблицы в «База hl7» → DBNAME=hl7 (проверка: psql … -d hl7 -c '\dn').
# POSTGRES_DB=postgres в .env на hl12 — только дефолт контейнера; приложение может подключаться к другой БД (hl7).
#
# SPRING_FLYWAY_CREATE_SCHEMAS=false: схему hl7 создаёт админ; у hl7 должен быть CONNECT на выбранную БД.
SPRING_FLYWAY_CREATE_SCHEMAS=false

DBHOST=hl12.zil
DBPORT=5433
DBNAME=hl7
SCHEMANAME=hl7
SPRING_DATASOURCE_USERNAME=hl7
# Пароль роли hl7 на hl12 (должен совпадать с CREATE ROLE / ALTER USER; не подставляйте hl_postgres).
SPRING_DATASOURCE_PASSWORD=hl7_labs

# Образ основного приложения — Docker Hub (в katya Harbor репозитория zil-app нет).
ZIL_APP_IMAGE=docker.io/rinakt/zil-app:hl7-latest
# Additional — Harbor (репозиторий katya/zil-additional-service, тег lab8).
ZIL_ADDITIONAL_IMAGE=hl13.zil:8888/katya/zil-additional-service:lab8

# Если Hub недоступен — свой тег; Additional при необходимости с Hub (не наш типичный сценарий):
# ZIL_ADDITIONAL_IMAGE=docker.io/rinakt/zil-additional:hl7-latest

# Опционально — лимиты на ВМ (см. docker-compose.yml):
# APP_CPUS=0.5
# APP_MEM=768m
# ADDITIONAL_CPUS=0.5
# ADDITIONAL_MEM=512m
