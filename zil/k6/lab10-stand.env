# LAB10: настройки стенда (hl07 + hl11). При другой таблице курса поправьте IP/пути.
#
# SSH на ВМ, где выполняете docker compose (hl07):
HL07_SSH="hl@10.60.3.2"
#
# Каталог zil на hl07:
REMOTE_ZIL="/home/hl/work/Labs_hls/zil"
#
REMOTE_ENV_FILE="registry-tags-lab8-hl7.env"
#
# Хост, где слушает **8084** (additional). Оба контейнера на hl07 → IP hl07; additional на hl13 → IP hl13.
export BASE_URL="http://10.60.3.2:8084"
#
# Проверка app с hl11; если 8083 недоступен с k6-ВМ — закомментируйте:
export APP_CHECK_URL="http://10.60.3.2:8083/stats"
# export APP_CHECK_URL=
