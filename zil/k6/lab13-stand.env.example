# ═══════════════════════════════════════════════════════════════════════════
# LAB13 — настройки для автоматических скриптов в этом каталоге (копия → lab13-stand.env)
#
#   Что запускать на ВМ с **k6** (типично **2311** или **hl11** с общей методичкой), когда прокси uvicorn уже работает:
#
#     ./lab13-k6-matrix.sh           ← ТЗ §0.8: 4 прогона k6
#     ./lab13-k6-matrix-graphs.sh    ← отчёт: 12 прогонов + графики LAB8-стиля
#
# Заполни ниже HL07_SSH (или алиас из ~/.ssh/config), REMOTE_ZIL. Для hl11 см. блок LAB13_STAND_ACCESS ниже.
# Не коммитьте lab13-stand.env с секретами — только этот пример.
# ═══════════════════════════════════════════════════════════════════════════

# SSH на ВМ docker compose (**2307** в таблице курса). Удобно — Host в ~/.ssh/config:
#   Host zil-vm2307
#     HostName hlssh.zil.digital
#     Port 2307
#     User hl
#     IdentityFile ~/.ssh/id_ed25519_zil_nopass
#
# Тогда можно задать только HL07_SSH=zil-vm2307 или явно DOCKER_SSH=user@host.
# Не задавайте DOCKER_SSH="" — оставьте одну переменную.
HL07_SSH="hl@10.60.3.XX"

REMOTE_ZIL="/home/hl/work/Labs_hls/zil"
# На ВМ приложений должен существовать этот каталог (часто ~/katya/Labs_hls/zil или ~/work/Labs_hls/zil).
REMOTE_ENV_FILE="registry-tags-lab8-hl7.env"
# Второй файл на 2307 (после git pull): registry-tags-lab13-topic.env → KAFKA_TOPIC=hl07-lab13 (2 партиции)
export REMOTE_ENV_TOPIC_FILE="registry-tags-lab13-topic.env"

# k6 LAB13 опрашивает additional на BASE_URL (GET /additional/stats при STATS_SHARE>0).
#
# Рекомендация для ВМ **hl11** (и любой k6-ВМ без прямого TCP до портов приложений): сразу туннель.
# Иначе curl/k6 дергают «чужой» 10.60.3.X → timeout / HTTP 000, хотя POST на локальный прокси живой.
export LAB13_STAND_ACCESS=tunnel
export BASE_URL="http://127.0.0.1:28084"
export APP_CHECK_URL="http://127.0.0.1:28083/stats"
#
# Если с вашей k6-ВМ VPN реально открывает порты до ВМ приложений — можно прямой доступ:
# export LAB13_STAND_ACCESS=auto
# export BASE_URL="http://10.60.3.XX:8084"
# export APP_CHECK_URL="http://10.60.3.XX:8083/stats"
#
# export LAB13_STAND_ACCESS=direct   # только прямой BASE_URL (без автотуннеля)

# Топик LAB13 (ТЗ: 2 партиции) — совпадает с registry-tags-lab13-topic.env / app.
export KAFKA_TOPIC="${KAFKA_TOPIC:-hl07-lab13}"

# Режим смесей задаётся именем скрипта (matrix vs matrix-graphs), не обязательно трогать:
# LAB13_MIX_PANELS=0

# Опционально:
# export TARGET_VUS=20
# export DURATION=3m
# export WARMUP_SEC=45
# export SKIP_PLOT=1
# export SKIP_PROXY_CHECK=1
# Продолжение после обрыва (по умолчанию в скрипте LAB13_RESUME=1): готовые *.json + *.json.done не перегоняются; полная ячейка пропускает compose.
# export LAB13_RESUME=0                    # полный перезапуск по всем ячейкам (перезапись summary по имени)
# export LAB13_STOP_ON_K6_FAIL=1           # остановить матрицу на первой ошибке k6
# export LAB13_SSH_PROBE_RETRIES=10
# После recreate контейнеров матрица ждёт стабильные 200 (пауза + несколько проверок подряд на 2307):
# export LAB13_REMOTE_READY_SEC=300
# export LAB13_EXTRA_SETTLE_SEC=25
# export LAB13_READY_STREAK=4
