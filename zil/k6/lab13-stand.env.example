# Скопируйте в lab13-stand.env рядом с lab13-k6-matrix.sh и подставьте свои значения.
#
# SSH на ВМ docker compose (**2307** в таблице курса). Удобно — Host в ~/.ssh/config:
#   Host zil-vm2307
#     HostName hlssh.zil.digital
#     Port 2307
#     User hl
#     IdentityFile ~/.ssh/id_ed25519_zil_nopass
#
# Тогда можно задать только HL07_SSH=zil-vm2307 или явно DOCKER_SSH=user@host.
# Не задавайте DOCKER_SSH="" — оставьте одну переменную.
HL07_SSH="hl@10.60.3.XX"

REMOTE_ZIL="/home/hl/work/Labs_hls/zil"
# Если у вас путь ~/katya/Labs_hls/zil — впишите его сюда.
REMOTE_ENV_FILE="registry-tags-lab8-hl7.env"

# k6 LAB13 опрашивает additional на BASE_URL (опциональный GET /additional/stats при STATS_SHARE>0).
# Укажите **IP или DNS ВМ 2307**, если k6 крутится не на ней.
export BASE_URL="http://10.60.3.XX:8084"
export APP_CHECK_URL="http://10.60.3.XX:8083/stats"

# Прокси на **этой же** ВМ что и k6 (по умолчанию localhost):
export PROXY_URL="http://127.0.0.1:18080/publish"

# Опционально:
# export TARGET_VUS=20
# export DURATION=3m
# export WARMUP_SEC=45
# export SKIP_PLOT=1
# export SKIP_PROXY_CHECK=1
