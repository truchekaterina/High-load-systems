# ═══════════════════════════════════════════════════════════════════════════
# LAB13 — настройки для автоматических скриптов в этом каталоге (копия → lab13-stand.env)
#
#   Что запускать на ВМ k6 (2311), когда прокси uvicorn уже работает:
#
#     ./lab13-k6-matrix.sh           ← ТЗ §0.8: 4 прогона k6
#     ./lab13-k6-matrix-graphs.sh    ← отчёт: 12 прогонов + графики LAB8-стиля
#
# Заполни ниже HL07_SSH (или алиас из ~/.ssh/config), REMOTE_ZIL, IP в BASE_URL / APP_CHECK_URL.
# Не коммитьте lab13-stand.env с секретами — только этот пример.
# ═══════════════════════════════════════════════════════════════════════════

# SSH на ВМ docker compose (**2307** в таблице курса). Удобно — Host в ~/.ssh/config:
#   Host zil-vm2307
#     HostName hlssh.zil.digital
#     Port 2307
#     User hl
#     IdentityFile ~/.ssh/id_ed25519_zil_nopass
#
# Тогда можно задать только HL07_SSH=zil-vm2307 или явно DOCKER_SSH=user@host.
# Не задавайте DOCKER_SSH="" — оставьте одну переменную.
HL07_SSH="hl@10.60.3.XX"

REMOTE_ZIL="/home/hl/work/Labs_hls/zil"
# Если у вас путь ~/katya/Labs_hls/zil — впишите его сюда.
REMOTE_ENV_FILE="registry-tags-lab8-hl7.env"
# Второй файл на 2307 (после git pull): registry-tags-lab13-topic.env → KAFKA_TOPIC=hl07-lab13 (2 партиции)
export REMOTE_ENV_TOPIC_FILE="registry-tags-lab13-topic.env"

# k6 LAB13 опрашивает additional на BASE_URL (опциональный GET /additional/stats при STATS_SHARE>0).
# Укажите **IP или DNS ВМ 2307**, если k6 крутится не на ней.
export BASE_URL="http://10.60.3.XX:8084"
export APP_CHECK_URL="http://10.60.3.XX:8083/stats"

# Топик LAB13 (ТЗ: 2 партиции) — совпадает с registry-tags-lab13-topic.env / app.
export KAFKA_TOPIC="${KAFKA_TOPIC:-hl07-lab13}"

# Режим смесей задаётся именем скрипта (matrix vs matrix-graphs), не обязательно трогать:
# LAB13_MIX_PANELS=0

# Опционально:
# export TARGET_VUS=20
# export DURATION=3m
# export WARMUP_SEC=45
# export SKIP_PLOT=1
# export SKIP_PROXY_CHECK=1
