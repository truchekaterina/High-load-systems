# Скопируйте в lab10-stand.env рядом со скриптами и подставьте свои значения.
# Файл lab10-stand.env не коммитьте (в .gitignore).
#
# SSH на ВМ, где выполняете docker compose (hl07):
HL07_SSH="hl@10.60.3.2"
#
# Каталог zil на hl07 (pwd после cd из ваших прошлых лаб):
REMOTE_ZIL="/home/hl/work/Labs_hls/zil"
#
REMOTE_ENV_FILE="registry-tags-lab8-hl7.env"
#
# То же, что в LAB9 часть 8: хост, где реально слушает **8084** (additional).
# Оба контейнера на hl07 → обычно IP hl07 (ниже). additional на hl13 → IP hl13.
export BASE_URL="http://10.60.3.2:8084"
#
# Проверка app с hl11; если 8083 недоступен с k6-ВМ — закомментируйте строку:
export APP_CHECK_URL="http://10.60.3.2:8083/stats"
# export APP_CHECK_URL=
#
# Редко: другой порт SSH — проще прописать Host в ~/.ssh/config, чем менять скрипты.
