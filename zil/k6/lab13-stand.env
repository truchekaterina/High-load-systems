# LAB13: ВМ с k6 (часто hl11). SSH на ВМ docker compose — см. ~/.ssh/config Host zil-vm2307 → hlssh:2307.
HL07_SSH="zil-vm2307"

REMOTE_ZIL="/home/hl/work/Labs_hls/zil"
REMOTE_ENV_FILE="registry-tags-lab8-hl7.env"
export REMOTE_ENV_TOPIC_FILE="registry-tags-lab13-topic.env"

# С hl11 VPN часто НЕ пускает TCP до IP ВМ приложений внутрь портов 8083/8084 — не используйте прямой 10.60.3.X.
# Режим tunnel: матрица сама поднимает -L 28083→8083 и -L 28084→8084 на удалённом localhost (ВМ 2307).
export LAB13_STAND_ACCESS=tunnel

export BASE_URL="http://127.0.0.1:28084"
export APP_CHECK_URL="http://127.0.0.1:28083/stats"

export PROXY_URL="http://127.0.0.1:18080/publish"
export KAFKA_TOPIC="${KAFKA_TOPIC:-hl07-lab13}"
export LAB13_RESUME="${LAB13_RESUME:-1}"
